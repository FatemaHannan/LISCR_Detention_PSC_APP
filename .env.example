REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here
# Note: REACT_APP_ANTHROPIC_API_KEY is no longer used here — the Anthropic key now lives
# server-side only, as a Supabase Edge Function secret (see supabase/functions/claude-proxy).
# Set it with: supabase secrets set ANTHROPIC_API_KEY=your-key-here
